#!/bin/sh
set -eu
subject=$(head -n 1 "$1")
case "$subject" in Merge*|Revert*) exit 0 ;; esac
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'; then
  echo 'Expected a Conventional Commit subject: feat(scope): description' >&2
  exit 1
fi
